{
  "$comment": "Masari brand tokens — shared source for web (packages/ui/src/styles.css) and the future Flutter ThemeData.",
  "color": {
    "navy": { "50": "#EEF3F8", "100": "#D6E1EC", "300": "#7E9CBD", "500": "#2F5580", "700": "#173556", "900": "#0F2741", "950": "#081729" },
    "green": { "50": "#E6FBF4", "100": "#C2F5E3", "300": "#4DDCB2", "400": "#1ACF9C", "500": "#00C48C", "600": "#00A576", "700": "#007F5C" },
    "teal": "#0B6E7A",
    "snow": "#F5F8FA",
    "charcoal": "#1F2937",
    "mist": "#E5E7EB",
    "semantic": {
      "background": "#F5F8FA",
      "surface": "#FFFFFF",
      "ink": "#0F2741",
      "inkMuted": "#475569",
      "line": "#E5E7EB",
      "primary": "#00C48C",
      "onPrimary": "#0F2741",
      "primaryText": "#007F5C"
    },
    "status": { "gray": "#64748B", "blue": "#2563EB", "indigo": "#4F46E5", "sky": "#0284C7", "amber": "#D97706", "orange": "#EA580C", "green": "#00A576", "red": "#DC2626", "rose": "#E11D48", "navy": "#0F2741" }
  },
  "gradient": { "logo": ["#00C48C", "#0B6E7A", "#0F2741"] },
  "font": {
    "arabic": "Tajawal",
    "latin": "Inter",
    "weights": { "regular": 400, "medium": 500, "bold": 700, "extraBold": 800, "black": 900 },
    "scale": { "caption": 12, "body": 16, "title": 20, "headline": 28, "display": 44 }
  },
  "radius": { "xs": 6, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 28 },
  "spacing": { "base": 4 },
  "notes": [
    "Primary buttons use green-500 background with navy-900 text (white on #00C48C fails WCAG contrast).",
    "Every API enum returns { value, label, color }; map `color` through color.status."
  ]
}
